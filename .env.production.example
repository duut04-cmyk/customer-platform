# Production backend API base (includes /api/v1).
# Set NEXT_PUBLIC_API_BASE_URL on your host (Vercel, Render, etc.) or copy to .env.production for local prod builds.
# Endpoint paths in code are relative (e.g. /auth/login) — do not append /api/v1 again.
NEXT_PUBLIC_API_BASE_URL=https://doot-backend.onrender.com/api/v1

# Google Sign-In — same OAuth Web Client ID as backend GOOGLE_CLIENT_ID
# Add your production frontend origin to Authorized JavaScript origins in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional — maps integration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
