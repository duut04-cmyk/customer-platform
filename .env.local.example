# Public backend API base (includes /api/v1). Endpoint paths are relative (e.g. /auth/login).
# Always use localhost (or your deployed API) here — NOT an ngrok URL. Ngrok is for Cashfree
# webhooks only (backend CASHFREE_NOTIFY_URL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Production — see .env.production.example (or set on your hosting provider)

# Google Sign-In — same OAuth Web Client ID as backend GOOGLE_CLIENT_ID
# Add http://localhost:3000 to Authorized JavaScript origins in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps — autocomplete, geocoding, live tracking route maps (road path + driver pin)
# Enable: Maps JavaScript API, Places API (New), Geocoding API, Directions API,
#         Maps Embed API, Maps Static API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Development only: inject a MOCK quote when orchestration returns no selectedOption (UI walkthrough).
NEXT_PUBLIC_DEV_MOCK_ORCHESTRATION=false

# Development only: show "Simulate next step" on delivery tracking (requires backend ENABLE_DEV_DELIVERY_SIMULATE).
NEXT_PUBLIC_DEV_SIMULATE_DELIVERY=false

# Cloudflare R2 — server-only (used by Next.js /api/package-photos/presign, NOT exposed to the browser).
# Create bucket "doot". Object keys: staging/{customerId}/{uploadBatchId}/photos/{uuid}.ext
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=doot
# Public read base for displaying photos (optional; backend API also uses R2_PUBLIC_BASE_URL for history URLs).
R2_PUBLIC_BASE_URL=

# Cashfree checkout (sandbox) — public flags only; never put CLIENT_SECRET here.
# Backend holds CASHFREE_CLIENT_ID / CASHFREE_CLIENT_SECRET / CASHFREE_NOTIFY_URL.
# Ngrok belongs on backend notify URL, not NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_CASHFREE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_CASHFREE_CHECKOUT_MODE=sandbox
# Backend CASHFREE_RETURN_URL should match this route, e.g. http://localhost:3000/checkout/success
