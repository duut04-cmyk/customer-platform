# Public backend API base (includes /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Google Sign-In — same OAuth Web Client ID as backend GOOGLE_CLIENT_ID
# Add http://localhost:3000 to Authorized JavaScript origins in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional — maps integration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
